# ==============================================================================
# Django Configuration
# ==============================================================================
SECRET_KEY=django-insecure-milan-magrati-portfolio-key-change-in-production-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# ==============================================================================
# Database Configuration (Supabase PostgreSQL)
# ==============================================================================
# In production on Render, paste your Supabase PostgreSQL connection string:
# Session Pooler (Recommended for Render): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Leave empty for local development SQLite fallback (db.sqlite3)
DATABASE_URL=

# ==============================================================================
# Media Storage (Cloudinary)
# ==============================================================================
# Get these credentials from your Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, you can use the single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ==============================================================================
# Admin Initial Setup (Used by 'python manage.py seed_portfolio')
# ==============================================================================
ADMIN_USERNAME=admin
